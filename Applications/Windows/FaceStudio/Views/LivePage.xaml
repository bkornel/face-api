<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaceStudio.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FaceStudio.Controls"
    xmlns:models="using:FaceStudio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,4,24,20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="392" />
        </Grid.ColumnDefinitions>

        <!-- The camera, and the four numbers that say whether it is going well -->
        <Grid Grid.Column="0" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Live" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />

                <Border x:Name="OverlayOwnerBadge" Style="{StaticResource PillStyle}"
                        HorizontalAlignment="Right" Visibility="Collapsed"
                        ToolTipService.ToolTip="The graph is wired so that the pipeline's own Visualizer draws the overlay. This application is showing that frame as it is.">
                    <TextBlock Text="Overlay drawn by the pipeline" Style="{StaticResource PillTextStyle}" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" MinHeight="320">
                <Grid>
                    <SwapChainPanel x:Name="VideoPanel" />

                    <!-- Sits over the panel and is only visible when nothing has been opened,
                         so the empty state is a XAML surface rather than a black rectangle -->
                    <StackPanel x:Name="EmptyOverlay" Spacing="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE714;" FontSize="26"
                                  Foreground="{ThemeResource TextTertiaryBrush}" />
                        <TextBlock Text="Choose a camera or open a video to begin"
                                   Style="{StaticResource BodyStyle}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TightCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="PIPELINE" Style="{StaticResource SectionCaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="PipelineFpsText" Text="0.0" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="fps" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource TightCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="LATENCY" Style="{StaticResource SectionCaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="LatencyText" Text="0.0" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="ms" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource TightCardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="FACES" Style="{StaticResource SectionCaptionStyle}" />
                        <TextBlock x:Name="FaceCountText" Text="0" Style="{StaticResource MetricValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource TightCardStyle}"
                        ToolTipService.ToolTip="Frames pushed that the pipeline has not returned yet.">
                    <StackPanel Spacing="2">
                        <TextBlock Text="IN FLIGHT" Style="{StaticResource SectionCaptionStyle}" />
                        <TextBlock x:Name="QueueText" Text="0" Style="{StaticResource MetricValueStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- The inspector: what is being watched, what it is doing, and how it is drawn -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Spacing="14">

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="SOURCE" Style="{StaticResource SectionCaptionStyle}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="CameraCombo" Grid.Column="0"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="No camera found"
                                      SelectionChanged="OnCameraSelectionChanged" />

                            <Button Grid.Column="1" Click="OnRefreshCamerasClicked"
                                    ToolTipService.ToolTip="Look for cameras again">
                                <FontIcon FontSize="13" Glyph="&#xE72C;" />
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Open video…" Click="OnOpenFileClicked"
                                    HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="Stop" Click="OnStopClicked"
                                    HorizontalAlignment="Stretch" />
                        </Grid>

                        <ToggleSwitch x:Name="LoopSwitch" Header="Loop video files"
                                      Toggled="OnLoopToggled" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="ARTIFICIAL HEAD" Style="{StaticResource SectionCaptionStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="drag to orbit" Style="{StaticResource HintStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Border CornerRadius="10" Background="{ThemeResource SurfaceSunkenBrush}" Height="248">
                            <SwapChainPanel x:Name="HeadPanel" />
                        </Border>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Expression" Style="{StaticResource BodyStyle}" />
                                <TextBlock x:Name="ExpressionValueText" Text="1.00"
                                           Style="{StaticResource MetricSmallValueStyle}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="ExpressionSlider" Minimum="0" Maximum="2.5" StepFrequency="0.05"
                                    Value="1.2" ValueChanged="OnHeadOptionChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Distance" Style="{StaticResource BodyStyle}" />
                                <TextBlock x:Name="DistanceValueText" Text="3.10"
                                           Style="{StaticResource MetricSmallValueStyle}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="DistanceSlider" Minimum="1.8" Maximum="6" StepFrequency="0.1"
                                    Value="3.1" ValueChanged="OnHeadOptionChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="FollowPoseCheck" Content="Follow pose" IsChecked="True"
                                      Checked="OnHeadCheckChanged" Unchecked="OnHeadCheckChanged" />
                            <CheckBox x:Name="WireframeCheck" Content="Wireframe"
                                      Checked="OnHeadCheckChanged" Unchecked="OnHeadCheckChanged" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="LandmarksCheck" Content="Landmarks"
                                      Checked="OnHeadCheckChanged" Unchecked="OnHeadCheckChanged" />
                            <CheckBox x:Name="EyesCheck" Content="Eyes" IsChecked="True"
                                      Checked="OnHeadCheckChanged" Unchecked="OnHeadCheckChanged" />
                            <Button Content="Reset view" Click="OnResetOrbitClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="FACES" Style="{StaticResource SectionCaptionStyle}" />

                        <TextBlock x:Name="NoFacesText" Text="Nothing is being tracked."
                                   Style="{StaticResource HintStyle}" />

                        <ItemsControl x:Name="FacesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:FaceStatus">
                                    <Border Background="{ThemeResource SurfaceSunkenBrush}"
                                            CornerRadius="10" Padding="14,12,14,14">
                                        <StackPanel Spacing="10">

                                            <Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <Border Width="8" Height="8" CornerRadius="4"
                                                            Background="{x:Bind Accent, Mode=OneWay}"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               Style="{StaticResource CardTitleStyle}" />
                                                </StackPanel>

                                                <TextBlock Text="{x:Bind StateText, Mode=OneWay}"
                                                           Style="{StaticResource HintStyle}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <Grid ColumnSpacing="10" RowSpacing="7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Yaw"
                                                           Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind YawText, Mode=OneWay}"
                                                           Style="{StaticResource MetricSmallValueStyle}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <controls:Meter Grid.Row="0" Grid.Column="2" Mode="Centered"
                                                                Minimum="-60" Maximum="60"
                                                                Value="{x:Bind Yaw, Mode=OneWay}"
                                                                Accent="{x:Bind Accent, Mode=OneWay}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pitch"
                                                           Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind PitchText, Mode=OneWay}"
                                                           Style="{StaticResource MetricSmallValueStyle}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <controls:Meter Grid.Row="1" Grid.Column="2" Mode="Centered"
                                                                Minimum="-45" Maximum="45"
                                                                Value="{x:Bind Pitch, Mode=OneWay}"
                                                                Accent="{x:Bind Accent, Mode=OneWay}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Roll"
                                                           Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind RollText, Mode=OneWay}"
                                                           Style="{StaticResource MetricSmallValueStyle}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <controls:Meter Grid.Row="2" Grid.Column="2" Mode="Centered"
                                                                Minimum="-45" Maximum="45"
                                                                Value="{x:Bind Roll, Mode=OneWay}"
                                                                Accent="{x:Bind Accent, Mode=OneWay}" />
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource SeparatorBrush}" />

                                            <Grid ColumnSpacing="10" RowSpacing="7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="108" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mouth"
                                                           Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                                <controls:Meter Grid.Row="0" Grid.Column="1"
                                                                Value="{x:Bind OpenMouth, Mode=OneWay}"
                                                                Accent="{x:Bind Accent, Mode=OneWay}" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Eyes"
                                                           Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <controls:Meter Grid.Column="0"
                                                                    Value="{x:Bind OpenEyeRight, Mode=OneWay}"
                                                                    Accent="{x:Bind Accent, Mode=OneWay}" />
                                                    <controls:Meter Grid.Column="1"
                                                                    Value="{x:Bind OpenEyeLeft, Mode=OneWay}"
                                                                    Accent="{x:Bind Accent, Mode=OneWay}" />
                                                </Grid>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Brows"
                                                           Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                                <controls:Meter Grid.Row="2" Grid.Column="1"
                                                                Value="{x:Bind BrowRaise, Mode=OneWay}"
                                                                Accent="{x:Bind Accent, Mode=OneWay}" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Smile"
                                                           Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
                                                <controls:Meter Grid.Row="3" Grid.Column="1"
                                                                Value="{x:Bind Smile, Mode=OneWay}"
                                                                Accent="{x:Bind Accent, Mode=OneWay}" />
                                            </Grid>

                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="DISTANCE" Style="{StaticResource SectionCaptionStyle}" />
                                                    <TextBlock Text="{x:Bind DistanceText, Mode=OneWay}"
                                                               Style="{StaticResource MetricSmallValueStyle}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="SIZE" Style="{StaticResource SectionCaptionStyle}" />
                                                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}"
                                                               Style="{StaticResource MetricSmallValueStyle}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="TRACKED" Style="{StaticResource SectionCaptionStyle}" />
                                                    <TextBlock Text="{x:Bind AgeText, Mode=OneWay}"
                                                               Style="{StaticResource MetricSmallValueStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Detect now" Click="OnForceDetectionClicked" />
                            <Button Content="Clear" Click="OnClearUsersClicked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="OVERLAY" Style="{StaticResource SectionCaptionStyle}" />

                        <StackPanel x:Name="OverlayToggles" Spacing="4">
                            <CheckBox x:Name="MirrorCheck" Content="Mirror the view" IsChecked="True"
                                      Checked="OnOverlayChanged" Unchecked="OnOverlayChanged" />
                            <CheckBox x:Name="MeshCheck" Content="Feature mesh" IsChecked="True"
                                      Checked="OnOverlayChanged" Unchecked="OnOverlayChanged" />
                            <CheckBox x:Name="PointsCheck" Content="Landmark points" IsChecked="True"
                                      Checked="OnOverlayChanged" Unchecked="OnOverlayChanged" />
                            <CheckBox x:Name="RectCheck" Content="Face brackets" IsChecked="True"
                                      Checked="OnOverlayChanged" Unchecked="OnOverlayChanged" />
                            <CheckBox x:Name="PoseBoxCheck" Content="Pose box" IsChecked="True"
                                      Checked="OnOverlayChanged" Unchecked="OnOverlayChanged" />
                            <CheckBox x:Name="AxesCheck" Content="Pose axes" IsChecked="True"
                                      Checked="OnOverlayChanged" Unchecked="OnOverlayChanged" />
                            <CheckBox x:Name="LabelsCheck" Content="Labels" IsChecked="True"
                                      Checked="OnOverlayChanged" Unchecked="OnOverlayChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="Glow" Style="{StaticResource BodyStyle}" />
                                <TextBlock x:Name="GlowValueText" Text="1.00"
                                           Style="{StaticResource MetricSmallValueStyle}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="GlowSlider" Minimum="0" Maximum="2" StepFrequency="0.05"
                                    Value="1" ValueChanged="OnOverlaySliderChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
