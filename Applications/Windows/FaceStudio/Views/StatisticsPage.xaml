<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaceStudio.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FaceStudio.Controls"
    xmlns:models="using:FaceStudio.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,4,24,24" Spacing="16" MaxWidth="1180" HorizontalAlignment="Left">

            <TextBlock Text="Statistics" Style="{StaticResource PageTitleStyle}" />

            <!-- The four numbers that answer "is it keeping up". Capture against pipeline is
                 the important pair: a gap between them is frames being dropped. -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="CAPTURE" Style="{StaticResource SectionCaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="CaptureFpsText" Text="0.0" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="fps" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="frames taken from the source" Style="{StaticResource HintStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="PIPELINE" Style="{StaticResource SectionCaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="PipelineFpsText" Text="0.0" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="fps" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="frames processed to the end" Style="{StaticResource HintStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="RENDER" Style="{StaticResource SectionCaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="RenderFpsText" Text="0.0" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="fps" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="presents of the two views" Style="{StaticResource HintStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="LATENCY" Style="{StaticResource SectionCaptionStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="LatencyAvgText" Text="0.0" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="ms avg" Style="{StaticResource MetricUnitStyle}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                        </StackPanel>
                        <TextBlock x:Name="LatencyRangeText" Text="—" Style="{StaticResource HintStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="LATENCY OVER TIME" Style="{StaticResource SectionCaptionStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="LatencyPeakText" Text="—" Style="{StaticResource HintStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <controls:Sparkline x:Name="LatencyChart" Height="92" />
                        <TextBlock Text="Capture to the end of the graph, per frame. A spike is a frame the shape model took longer on."
                                   Style="{StaticResource HintStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="THROUGHPUT" Style="{StaticResource SectionCaptionStyle}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="3" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{ThemeResource TextTertiaryBrush}" />
                                    <TextBlock Text="capture" Style="{StaticResource HintStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="3" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{ThemeResource AccentBrush}" />
                                    <TextBlock Text="pipeline" Style="{StaticResource HintStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Height="92">
                            <controls:Sparkline x:Name="CaptureChart" Stroke="{ThemeResource TextTertiaryBrush}" />
                            <controls:Sparkline x:Name="PipelineChart" />
                        </Grid>
                        <TextBlock Text="A gap between the two lines is the pipeline falling behind the source."
                                   Style="{StaticResource HintStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="WHERE THE TIME GOES" Style="{StaticResource SectionCaptionStyle}" />

                    <TextBlock x:Name="NoStagesText"
                               Text="The build of the API in use was compiled without its profiler, so it does not report per-stage timings."
                               Style="{StaticResource HintStyle}" Visibility="Collapsed" />

                    <ItemsControl x:Name="StagesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="9" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:StageTiming">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                               Style="{StaticResource BodyStyle}"
                                               VerticalAlignment="Center" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />

                                    <controls:Meter Grid.Column="1" Height="8"
                                                    Value="{x:Bind Share, Mode=OneWay}" />

                                    <TextBlock Grid.Column="2" Text="{x:Bind MillisecondsText, Mode=OneWay}"
                                               Style="{StaticResource MetricSmallValueStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="COUNTERS" Style="{StaticResource SectionCaptionStyle}" />

                    <Grid ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="CAPTURED" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="CapturedText" Text="0" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="PROCESSED" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="ProcessedText" Text="0" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="PRESENTED" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="RenderedText" Text="0" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3"
                                    ToolTipService.ToolTip="Frames pushed while the pipeline's queue was already full. Those are the ones it drops.">
                            <TextBlock Text="OVERRUN" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="DroppedText" Text="0" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="IN FLIGHT" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="QueueText" Text="0" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="FRAME" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="FrameIdText" Text="0" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="SOURCE" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="SourceSizeText" Text="—" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="P95 LATENCY" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="LatencyP95Text" Text="0.0 ms" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3">
                            <TextBlock Text="WORST" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="LatencyMaxText" Text="0.0 ms" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <TextBlock Text="FACES" Style="{StaticResource SectionCaptionStyle}" />
                            <TextBlock x:Name="FaceCountText" Text="0" Style="{StaticResource MetricSmallValueStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
