<?xml version="1.0" encoding="utf-8"?>
<!--
    The design tokens of the application, in one place.

    The chrome is Windows - Mica behind everything, Fluent controls, the system accent where
    it belongs - and the layout is not: generous spacing, few borders, one accent, and cards
    that are surfaces rather than boxes. A value that appears twice in a view belongs here
    instead, which is what keeps the three pages looking like one application.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <!-- A card is a lift off the Mica, not a panel drawn on top of it, so it is a
                 translucent white rather than a colour of its own -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundStrongBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#26000000" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="#14FFFFFF" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#66FFFFFF" />

            <SolidColorBrush x:Key="AccentBrush" Color="#4DC7FF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#334DC7FF" />
            <SolidColorBrush x:Key="PositiveBrush" Color="#8CF099" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFBA59" />
            <SolidColorBrush x:Key="NegativeBrush" Color="#FF7878" />

            <SolidColorBrush x:Key="MeterTrackBrush" Color="#1FFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundStrongBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="#14000000" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#61000000" />

            <SolidColorBrush x:Key="AccentBrush" Color="#0A84C4" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#280A84C4" />
            <SolidColorBrush x:Key="PositiveBrush" Color="#2E8B47" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B57516" />
            <SolidColorBrush x:Key="NegativeBrush" Color="#C1362F" />

            <SolidColorBrush x:Key="MeterTrackBrush" Color="#1A000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBackgroundStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PositiveBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NegativeBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="MeterTrackBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing. Everything is a multiple of four, and there are five of them, because a
         layout with a spacing for every occasion has none. -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">16</x:Double>
    <x:Double x:Key="SpaceL">24</x:Double>
    <x:Double x:Key="SpaceXL">40</x:Double>

    <Thickness x:Key="CardPadding">20,18,20,18</Thickness>
    <Thickness x:Key="CardPaddingTight">16,14,16,14</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- A surface that holds one idea. Cards are what the whole application is built from. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="TightCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="{StaticResource CardPaddingTight}" />
    </Style>

    <!-- The label above a group. Small, spaced and quiet: it names the thing below without
         competing with it. -->
    <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="HintStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <!-- A number that changes every frame. Fixed width so the layout does not shiver as the
         digits change, which is the single most important thing about a live statistic. -->
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MetricSmallValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="MetricUnitStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <!-- The pill that carries a short state: the source, whether it is running, a track's
         state. Always one line, always the same height. -->
    <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundStrongBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="10,4,10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
