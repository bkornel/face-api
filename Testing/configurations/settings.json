{
  "face": {
    "general": {
      "output": {
        "verbose": "FALSE",
        "video": "FALSE",
        "videoFourCC": "XVID",
        "videoFPS": "25"
      },
      "directories": {
        "faceDetector": "facedetector/",
        "shapeModel": "shapemodel/",
        "output": "output/"
      }
    },
    "modules": {
      "firstModule": {
        "port": []
      },
      "imageQueue": {
        "port": [ "firstModule:1" ],
        "bound": "10",
        "samplingFPS": "30.0",
        "thresholdMS": "100"
      },
      "faceDetection": {
        "port": [ "imageQueue:1" ],
        "detectionSec": "10.0",
        "detectionOverlap": "0.2",
        "detectMultiScale": {
          "flags": "0",
          "maxSize": "1.0",
          "minNeighbors": "3",
          "minSize": "0.05",
          "scaleFactor": "1.1"
        },
        "fileName": "haarcascade_frontalface_alt2.xml",
        "imageScale": "1.0"
      },
      "faceTracker": {
        "port": [ "imageQueue:1", "faceDetection:2" ],
        "maxTracks": "1",
        "trackAwaySec": "15.0",
        "trackOverlap": "0.2",
        "templateScale": "0.3"
      },
      "shapeModel": {
        "port": [ "imageQueue:1", "faceTracker:2" ],
        "method": "3ddfa",
        "modelDir": "3ddfa/",
        "smoothing": "TRUE",
        "clamp": "3.0",
        "conFile": "face.con",
        "failureCheck": "FALSE",
        "fTol": "0.01",
        "nIter": "5",
        "parallelUsers": "TRUE",
        "trackerFile": "face.tracker",
        "triFile": "face.tri",
        "winDetection": "11,9,7",
        "winTracking": "7"
      },
      "headPose": {
        "port": [ "shapeModel:1" ],
        "estimateReprojection": "FALSE",
        "faceBoxOffset": "5.0",
        "parallelUsers": "TRUE"
      },
      "shapeNorm": {
        "port": [ "shapeModel:1", "headPose:2" ],
        "maxCount": "1000",
        "epsilon": "1e-6",
        "parallelUsers": "TRUE"
      },
      "userManager": {
        "port": [ "faceTracker:1", "shapeModel:2", "headPose:3", "shapeNorm:4" ]
      },
      "userHistory": {
        "port": [ "userManager:1" ],
        "removeFreqMs": "10000"
      },
      "visualizer": {
        "port": [ "imageQueue:1", "userManager:2" ]
      },
      "lastModule": {
        "port": [ "visualizer:1", "userManager:2" ]
      }
    }
  }
}